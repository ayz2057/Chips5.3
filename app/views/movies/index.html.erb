<!--  This file is app/views/movies/index.html.erb -->

<p style="color: green"><%= notice %></p>
<h1>Movies</h1>
<%= link_to "Title", movies_path(home: "1", sort_by: "title", ratings: @ratings_to_show.to_h { |rating| [rating, "1"] }) %>
<%= link_to "Release Date", movies_path(home: "1", sort_by: "release_date", ratings: @ratings_to_show.to_h { |rating| [rating, "1"] }) %>
<%= form_tag movies_path, method: :get, id: 'ratings_form', local: true do %>
  <%= hidden_field_tag :home, "1" %>
  Include:
  <% @all_ratings.each do |rating| %>
    <div class="form-check  form-check-inline">
      <%= check_box_tag "ratings[#{rating}]", "1", @ratings_to_show.include?(rating), class: 'form-check-input' %>
      <%= label_tag "ratings[#{rating}]", rating, class: 'form-check-label' %>
    </div>
  <% end %>
  <div>
    <label class="form-label me-2" for="sort_by">Sort by:</label>
    <%= select_tag :sort_by,
                   options_for_select([["Title", "title"],
                                       ["Release Date", "release_date"]],
                                       @sort_by),
                   id:    "sort_by",
                   class: "form-select d-inline w-auto" %>
  </div>
  <%= submit_tag 'Refresh', id: 'ratings_submit', class: 'btn btn-primary' %>
  
<% end %>
